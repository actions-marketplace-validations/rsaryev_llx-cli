[0.0, "o", "\u001b[?2026h\u001b[3A\r\u001b[J\u001b[1mPublish\u001b[0m\u001b[1m \u001b[0m\u001b[1mto\u001b[0m\u001b[1m \u001b[0m\u001b[1mPyPI\u001b[0m\r\n\u001b[1;32m1 \u001b[0m\u001b[1mAdd\u001b[0m\u001b[1m \u001b[0m\u001b[1mpackaging\u001b[0m\u001b[1m \u001b[0m\u001b[1mmetadata.\u001b[0m This project has no \u001b[36mpyproject.toml\u001b[0m yet. Create one with the name, version,\r\n\u001b[2m\u2502 \u001b[0mand \u001b[36mstats.py\u001b[0m as the module. Check that the name is free on pypi.org first, since \u001b[36mstats\u001b[0m is likely\r\n\u001b[2m\u2502 \u001b[0mtaken.\r\n\u001b[2m\u2502\u001b[0m\r\n\u001b[1;32m2 \u001b[0m\u001b[1mBuild\u001b[0m\u001b[1m \u001b[0m\u001b[1mthe\u001b[0m\u001b[1m \u001b[0m\u001b[1mdistribution.\u001b[0m Run \u001b[36mpython3\u001b[0m\u001b[36m \u001b[0m\u001b[36m-m\u001b[0m\u001b[36m \u001b[0m\u001b[36mpip\u001b[0m\u001b[36m \u001b[0m\u001b[36minstall\u001b[0m\u001b[36m \u001b[0m\u001b[36mbuild\u001b[0m\u001b[36m \u001b[0m\u001b[36m&&\u001b[0m\u001b[36m \u001b[0m\u001b[36mpython3\u001b[0m\u001b[36m \u001b[0m\u001b[36m-m\u001b[0m\u001b[36m \u001b[0m\u001b[36mbuild\u001b[0m. This writes a wheel\r\n\u001b[2m\u2502 \u001b[0mand an sdist to \u001b[36mdist/\u001b[0m.\r\n\u001b[2m\u2502\u001b[0m\r\n\u001b[1;32m3 \u001b[0m\u001b[1mUpload.\u001b[0m Run \u001b[36mpython3\u001b[0m\u001b[36m \u001b[0m\u001b[36m-m\u001b[0m\u001b[36m \u001b[0m\u001b[36mpip\u001b[0m\u001b[36m \u001b[0m\u001b[36minstall\u001b[0m\u001b[36m \u001b[0m\u001b[36mtwine\u001b[0m\u001b[36m \u001b[0m\u001b[36m&&\u001b[0m\u001b[36m \u001b[0m\u001b[36mpython3\u001b[0m\u001b[36m \u001b[0m\u001b[36m-m\u001b[0m\u001b[36m \u001b[0m\u001b[36mtwine\u001b[0m\u001b[36m \u001b[0m\u001b[36mupload\u001b[0m\u001b[36m "]
[0.0, "o", "\u001b[0m\u001b[36mdist/*\u001b[0m with a PyPI API token.\r\n  To rehearse first, add \u001b[36m--repository\u001b[0m\u001b[36m \u001b[0m\u001b[36mtestpypi\u001b[0m, and use a TestPyPI token.\r\n\r\nOnce the package is published, install it with the command for your tool:\r\n\r\n\u001b[1mInstall\u001b[0m\r\n\u001b[2m\u2500\u001b[0m\u001b[2m \u001b[0m\u001b[1mpip\u001b[0m\u001b[2m \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[36mpip\u001b[0m\u001b[36m \u001b[0m\u001b[36minstall\u001b[0m\u001b[36m \u001b[0m\u001b[36m<name>\u001b[0m\r\n\r\n\u001b[2m\u2500\u001b[0m\u001b[2m \u001b[0m\u001b[1muv\u001b[0m\u001b[2m \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[36muv\u001b[0m\u001b[36m \u001b[0m\u001b[36madd\u001b[0m\u001b[36m \u001b[0m\u001b[36m<name>\u001b[0m (in a project) or \u001b[36muv\u001b[0m\u001b[36m \u001b[0m\u001b[36mpip\u001b[0m\u001b[36m \u001b[0m\u001b[36minstall\u001b[0m\u001b[36m \u001b[0m\u001b[36m<name>\u001b[0m\r\n\r\n\u001b[2m\u2500\u001b[0m\u001b[2m \u001b[0m\u001b[1mPoetry\u001b[0m\u001b[2m \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[36mpoetry\u001b[0m\u001b[36m \u001b[0m\u001b[36madd\u001b[0m\u001b[36m \u001b[0m\u001b[36m<name>\u001b[0m\r\n\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[0.0, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\r\n\u001b[36m<name>\u001b[0m is the name you choose in step 1. I have not checked whether it is free on PyPI, because this\r\nsandbox has no network access.\r\n\r\n\u001b[2m\u2500 Worked for 4.4s \u00b7 1 turn \u00b7 $0.0005 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[1m\u276f \u001b[0m\u001b[2mType a task, / for commands\u001b[0m\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
