[0.026, "o", "\u001b[?2026h\u001b[5A\r\u001b[J\u001b[31m\u2022 \u001b[0m\u001b[1mRan\u001b[0m\u001b[1m \u001b[0mpython3 -m unittest -v\r\r\n\u001b[2m  \u2514 \u001b[0m\u001b[2mtest_mean (test_stats.MeanTest) ... ok\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2mtest_even_count (test_stats.MedianTest) ... FAIL\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2m\u2026 +10 lines\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2mRan 4 tests in 0.000s\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2mFAILED (failures=1)\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[31mExit code: 1\u001b[0m\r\r\n\r\r\n\u001b[36m\u2839\u001b[0m \u001b[1mWorking\u001b[0m\u001b[2m (5s \u00b7 esc stop)\u001b[0m\r\r\n\r\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n\u001b[1m\u276f \u001b[0m\u001b[2mType a task, / for commands\u001b[0m\r\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
