[0.0, "o", "\u001b[?2026h\u001b[5A\r\u001b[J\u001b[32m\u2022 \u001b[0m\u001b[1mPatched\u001b[0m\u001b[1m \u001b[0mstats.py\r\n\u001b[2m      7   7 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\n\u001b[2m      8   8 \u001b[0m\u001b[2m  \u001b[0m\u001b[2mdef median(values):\u001b[0m\r\n\u001b[2m      9   9 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    ordered = sorted(values)\u001b[0m\r\n\u001b[2m     10     \u001b[0m\u001b[31m- \u001b[0m\u001b[31m    middle = len(ordered) // 2\u001b[0m\r\n\u001b[2m     11     \u001b[0m\u001b[31m- \u001b[0m\u001b[31m    return ordered[middle]\u001b[0m\r\n\u001b[2m         10 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    count = len(ordered)\u001b[0m\r\n\u001b[2m         11 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    middle = count // 2\u001b[0m\r\n\u001b[2m         12 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    if count % 2 == 1:\u001b[0m\r\n\u001b[2m         13 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m        return ordered[middle]\u001b[0m\r\n\u001b[2m         14 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    return (ordered[middle - 1] + ordered[middle]) / 2\u001b[0m\r\n\u001b[2m     12  15 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\n\u001b[2m     13  16 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\n\u001b[2m     14  17 \u001b[0m\u001b[2m  \u001b[0m\u001b[2mdef spread(values):\u001b[0m\r\n\r\n\u001b[36m\u280b\u001b[0m \u001b[1mRunning\u001b[0m\u001b[1m \u001b[0mpython3 -m unittest -q 2>&1; echo \"exit=$?\"\r\n\r\n\u001b[36m\u280b\u001b[0m \u001b[1mWorking\u001b[0m\u001b[2m (3s \u00b7 esc stop)\u001b[0m\r\n\r\n\u001b[2m\u2500"]
