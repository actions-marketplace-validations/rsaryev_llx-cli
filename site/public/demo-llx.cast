[0.0, "o", "\u001b[?2026h\u001b[3A\r\u001b[J\u001b[36m\u280b\u001b[0m \u001b[1mPatching\u001b[0m stats.py\r\n\r\n\u001b[36m\u2807\u001b[0m \u001b[1mWorking\u001b[0m\u001b[2m (4s \u00b7 esc stop)\u001b[0m\r\n\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[1m\u276f \u001b[0m\u001b[2mType a task, / for commands\u001b[0m\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[2mdefault mode \u00b7 shift+tab to cycle                          23.5k in \u00b7 93% cached \u00b7 709 out \u00b7 $0.0008\u001b[0m\u001b[2A\r\u001b[2C\u001b[?25h\u001b[?2026l"]
[0.002, "o", "\u001b[?2026h\u001b[5A\r\u001b[J\u001b[32m\u2022 \u001b[0m\u001b[1mPatched\u001b[0m stats.py\r\n\u001b[2m      7   7 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\n\u001b[2m      8   8 \u001b[0m\u001b[2m  \u001b[0m\u001b[2mdef median(values):\u001b[0m\r\n\u001b[2m      9   9 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    ordered = sorted(values)\u001b[0m\r\n\u001b[2m     10     \u001b[0m\u001b[31m- \u001b[0m\u001b[31m    middle = len(ordered) // 2\u001b[0m\r\n\u001b[2m     11     \u001b[0m\u001b[31m- \u001b[0m\u001b[31m    return ordered[middle]\u001b[0m\r\n\u001b[2m         10 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    count = len(ordered)\u001b[0m\r\n\u001b[2m         11 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    middle = count // 2\u001b[0m\r\n\u001b[2m         12 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    if count % 2 == 1:\u001b[0m\r\n\u001b[2m         13 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m        return ordered[middle]\u001b[0m\r\n\u001b[2m         14 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    return (ordered[middle - 1] + ordered[middle]) / 2\u001b[0m\r\n\u001b[2m     12  15 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\n\u001b[2m     13  16 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\n\u001b[2m     14  17 \u001b[0m\u001b[2m  \u001b[0m\u001b[2mdef spread(values):\u001b[0m\r\n\r\n\u001b[36m\u280b\u001b[0m \u001b[1mRunning\u001b[0m python3 -m unittest -v test_stats 2>&1 | tail -5; python3 -c \" from stats import median\r\n\u001b[2m  \u2502 \u001b[0mprint(median([]) if False "]
[0.0, "o", "else '', median([1]), median([1,2]), median([3,1,2,4]),\r\n\u001b[2m  \u2502 \u001b[0mmedian([7,7]))\"\r\n\r\n\u001b[36m\u2807\u001b[0m \u001b[1mWorking\u001b[0m\u001b[2m (4s \u00b7 esc stop)\u001b[0m\r\n\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[1m\u276f \u001b[0m\u001b[2mType a task, / for commands\u001b[0m\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[2mdefault mode \u00b7 shift+tab to cycle                          23.5k in \u00b7 93% cached \u00b7 709 out \u00b7 $0.0008\u001b[0m\u001b[2A\r\u001b[2C\u001b[?25h\u001b[?2026l"]
