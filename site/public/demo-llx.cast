[0.0, "o", "\u001b[?2026h\u001b[3A\r\u001b[JYour project has no packaging metadata yet (no \u001b[36mpyproject.toml\u001b[0m), so step 1 adds it. Your code is a\r\nsingle \u001b[36mstats.py\u001b[0m module, so the build backend is the only real choice.\r\n\r\n\u001b[1mPublish\u001b[0m\u001b[1m \u001b[0m\u001b[1mto\u001b[0m\u001b[1m \u001b[0m\u001b[1mPyPI\u001b[0m\r\n\u001b[1;32m1  \u001b[0m\u001b[1mAdd\u001b[0m\u001b[1m \u001b[0m\u001b[1ma\u001b[0m\u001b[1m \u001b[0m\u001b[1;36mpyproject.toml\u001b[0m\u001b[1m.\u001b[0m\r\n\u001b[2m\u2502  \u001b[0mGive it a name, version and Python version, and a build backend. Use \u001b[36msetuptools\u001b[0m for the simplest\r\n\u001b[2m\u2502  \u001b[0msetup:\r\n\u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502  \u001b[0m\u001b[36m[build-system]\u001b[0m\r\n\u001b[2m\u2502  \u001b[0m\u001b[36mrequires = [\"setuptools>=68\"]\u001b[0m\r\n\u001b[2m\u2502  \u001b[0m\u001b[36mbuild-backend = \"setuptools.build_meta\"\u001b[0m\r\n\u001b[2m\u2502  \u001b[0m\u001b[36m\u001b[0m\r\n\u001b[2m\u2502  \u001b[0m\u001b[36m[project]\u001b[0m\r\n\u001b[2m\u2502  \u001b[0m\u001b[36mname = \"your-package-name\"\u001b[0m\r\n\u001b[2m\u2502  \u001b[0m\u001b[36mversion = \"0.1.0\"\u001b[0m\r\n\u001b[2m\u2502  \u001b[0m\u001b[36mrequires-python = \">=3.9\"\u001b[0m\r\n\u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502  \u001b[0mCheck that the name is free on PyPI first, because \u001b[36mstats\u001b[0m is probably taken.\r\n\u001b[2m\u2502\u001b[0m\r\n\u001b[1;32m2  \u001b[0m\u001b[1mBuild\u001b[0m\u001b[1m \u001b[0m\u001b[1mand"]
[0.0, "o", "\u001b[0m\u001b[1m \u001b[0m\u001b[1mcheck\u001b[0m\u001b[1m \u001b[0m\u001b[1mthe\u001b[0m\u001b[1m \u001b[0m\u001b[1mpackage.\u001b[0m\r\n\u001b[2m\u2502  \u001b[0mRun \u001b[36mpython\u001b[0m\u001b[36m \u001b[0m\u001b[36m-m\u001b[0m\u001b[36m \u001b[0m\u001b[36mbuild\u001b[0m to create the source and wheel files in \u001b[36mdist/\u001b[0m, then \u001b[36mtwine\u001b[0m\u001b[36m \u001b[0m\u001b[36mcheck\u001b[0m\u001b[36m \u001b[0m\u001b[36mdist/*\u001b[0m. Test\r\n\u001b[2m\u2502  \u001b[0mthe upload on TestPyPI first with \u001b[36mtwine\u001b[0m\u001b[36m \u001b[0m\u001b[36mupload\u001b[0m\u001b[36m \u001b[0m\u001b[36m--repository\u001b[0m\u001b[36m \u001b[0m\u001b[36mtestpypi\u001b[0m\u001b[36m \u001b[0m\u001b[36mdist/*\u001b[0m.\r\n\u001b[2m\u2502\u001b[0m\r\n\u001b[1;32m3  \u001b[0m\u001b[1mUpload\u001b[0m\u001b[1m \u001b[0m\u001b[1mto\u001b[0m\u001b[1m \u001b[0m\u001b[1mPyPI.\u001b[0m\r\n   Create an API token at pypi.org and run \u001b[36mtwine\u001b[0m\u001b[36m \u001b[0m\u001b[36mupload\u001b[0m\u001b[36m \u001b[0m\u001b[36mdist/*\u001b[0m. Use \u001b[36m__token__\u001b[0m as the username and\r\n   the token as the password. Tag the release in git so the version has a record.\r\n\r\n\u001b[1mInstall\u001b[0m\u001b[1m \u001b[0m\u001b[1mthe\u001b[0m\u001b[1m \u001b[0m\u001b[1mpublished\u001b[0m\u001b[1m \u001b[0m\u001b[1mpackage\u001b[0m\r\n\u001b[2m\u2500\u001b[0m\u001b[2m \u001b[0m\u001b[1mpip\u001b[0m\u001b[2m \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[36mpip"]
[0.0, "o", "\u001b[0m\u001b[36m \u001b[0m\u001b[36minstall\u001b[0m\u001b[36m \u001b[0m\u001b[36myour-package-name\u001b[0m\r\n\r\n\u001b[2m\u2500\u001b[0m\u001b[2m \u001b[0m\u001b[1muv\u001b[0m\u001b[2m \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[36muv\u001b[0m\u001b[36m \u001b[0m\u001b[36madd\u001b[0m\u001b[36m \u001b[0m\u001b[36myour-package-name\u001b[0m (in a uv project), or \u001b[36muv\u001b[0m\u001b[36m \u001b[0m\u001b[36mpip\u001b[0m\u001b[36m \u001b[0m\u001b[36minstall\u001b[0m\u001b[36m \u001b[0m\u001b[36myour-package-name\u001b[0m\r\n\r\n\u001b[2m\u2500\u001b[0m\u001b[2m \u001b[0m\u001b[1mpoetry\u001b[0m\u001b[2m \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[36mpoetry\u001b[0m\u001b[36m \u001b[0m\u001b[36madd\u001b[0m\u001b[36m \u001b[0m\u001b[36myour-package-name\u001b[0m\r\n\r\nReplace \u001b[36myour-package-name\u001b[0m with the name you chose in step 1. I did not check whether the name is\r\nfree on PyPI, because I have no network access from here.\r\n\r\n\u001b[2m\u2500 Worked for 5.1s \u00b7 1 turn \u00b7 $0.0006 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
