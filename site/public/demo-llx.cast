[0.0, "o", "\u001b[32mdef mode(values):\u001b[0m\r\r\n\u001b[2m         21 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    \"\"\"Return the most frequent value, breaking ties with the smallest value.\"\"\"\u001b[0m\r\r\n\u001b[2m         22 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    counts = Counter(values)\u001b[0m\r\r\n\u001b[2m         23 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    if not counts:\u001b[0m\r\r\n\u001b[2m         24 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m        raise ValueError(\"mode() requires at least one value\")\u001b[0m\r\r\n\u001b[2m         25 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    highest_frequency = max(counts.values())\u001b[0m\r\r\n\u001b[2m         26 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    return min(value for value, frequency in counts.items()\u001b[0m\r\r\n\u001b[2m         27 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m               if frequency == highest_frequency)\u001b[0m\r\r\n\u001b[2m    test_stats.py\u001b[0m\r\r\n\u001b[2m      1   1 \u001b[0m\u001b[2m  \u001b[0m\u001b[2mimport unittest\u001b[0m\r\r\n\u001b[2m      2   2 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\r\n\u001b[2m      3     \u001b[0m\u001b[31m- \u001b[0m\u001b[31mfrom stats import mean, median\u001b[0m\r\r\n\u001b[2m          3 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32mfrom stats import mean, median, mode\u001b[0m\r\r\n\u001b[2m      4   4 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\r\n\u001b[2m      5   5 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b["]
