[0.0, "o", "\u001b[?2026h\u001b[6A\r\u001b[J\r\n\u001b[32m\u2022 \u001b[0m\u001b[1mPatched\u001b[0m stats.py\r\n\u001b[2m      8   8 \u001b[0m\u001b[2m  \u001b[0m\u001b[2mdef median(values):\u001b[0m\r\n\u001b[2m      9   9 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    ordered = sorted(values)\u001b[0m\r\n\u001b[2m     10  10 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    middle = len(ordered) // 2\u001b[0m\r\n\u001b[2m     11     \u001b[0m\u001b[31m- \u001b[0m\u001b[31m    return ordered[middle]\u001b[0m\r\n\u001b[2m         11 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    if len(ordered) % 2 == 1:\u001b[0m\r\n\u001b[2m         12 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m        return ordered[middle]\u001b[0m\r\n\u001b[2m         13 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m    return (ordered[middle - 1] + ordered[middle]) / 2\u001b[0m\r\n\u001b[2m     12  14 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\n\u001b[2m     13  15 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\n\u001b[2m     14  16 \u001b[0m\u001b[2m  \u001b[0m\u001b[2mdef spread(values):\u001b[0m\r\n\r\n\u001b[36m\u280b\u001b[0m \u001b[1mRunning\u001b[0m python3 -m unittest -v 2>&1 | tail -4 && python3 -c \" from stats import median\r\n\u001b[2m  \u2502 \u001b[0mprint(median([7]), median([1,2]), median([3,1,2]), median([9,1,4,2,8,5]))\" && git diff --stat\r\n\r\n\u001b[36m\u2839\u001b[0m \u001b[1mWorking\u001b[0m\u001b[2m (5s \u00b7 esc stop)\u001b[0m\r\n\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
