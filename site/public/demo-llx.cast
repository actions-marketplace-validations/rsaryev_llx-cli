[0.001, "o", "\u001b[?2026h\u001b[5A\r\u001b[J\u001b[32m\u2022 \u001b[0m\u001b[1mPatched\u001b[0m\u001b[1m \u001b[0mstats.py, test_stats.py\r\r\n\u001b[2m  \u2514 \u001b[0m\u001b[2mM stats.py\u001b[0m\r\r\n\u001b[2m    \u001b[0m\u001b[2mM test_stats.py\u001b[0m\r\r\n\u001b[2m    stats.py\u001b[0m\r\r\n\u001b[2m      1   1 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\"\"\"Small statistics helpers.\"\"\"\u001b[0m\r\r\n\u001b[2m      2   2 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\r\n\u001b[2m          3 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32mfrom collections import Counter\u001b[0m\r\r\n\u001b[2m      3   4 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m\u001b[0m\r\r\n\u001b[2m          5 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m\u001b[0m\r\r\n\u001b[2m      4   6 \u001b[0m\u001b[2m  \u001b[0m\u001b[2mdef mean(values):\u001b[0m\r\r\n\u001b[2m      5   7 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    \"\"\"The arithmetic mean of a non-empty sequence.\"\"\"\u001b[0m\r\r\n\u001b[2m      6   8 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    return sum(values) / len(values)\u001b[0m\r\r\n\u001b[2m    \u2026\u001b[0m\r\r\n\u001b[2m     13  15 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    if len(ordered) % 2:\u001b[0m\r\r\n\u001b[2m     14  16 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m        return ordered[middle]\u001b[0m\r\r\n\u001b[2m     15  17 \u001b[0m\u001b[2m  \u001b[0m\u001b[2m    return (ordered[middle - 1] + ordered[middle]) / 2\u001b[0m\r\r\n\u001b[2m         18 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m\u001b[0m\r\r\n\u001b[2m         19 \u001b[0m\u001b[32m+ \u001b[0m\u001b[32m\u001b[0m\r\r\n\u001b[2m         "]
